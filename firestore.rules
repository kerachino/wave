rules_version = '2';

// ============================================================
// Firestore セキュリティルール（チャット・申込み用）
// Firebase コンソール（Firestore > Rules）に貼り付けて使用してください。
//
// ・chat_rooms/{roomId}                    … チャットルーム
// ・chat_rooms/{roomId}/messages/{id}      … メッセージ
// ・applications/{id}                      … お申し込み情報
//
// 運営側（スタッフ）の返信は Firebase コンソールから行う想定です。
// コンソールからの書き込みは、このルールの制約を受けません。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- チャットルーム ----
    // ログイン済みユーザーのみ、自分の uid のルームを作成・読み書きできます。
    match /chat_rooms/{roomId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if request.auth != null;

      // ---- メッセージ ----
      // ルームの持ち主のみ読み書きできます。
      match /messages/{messageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.uid == request.auth.uid;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.uid == request.auth.uid;
      }
    }

    // ---- お申し込み情報 ----
    // ログイン済みユーザーは自分の申込みのみ作成でき、
    // 読み書きは運営（コンソール）が行います。
    match /applications/{applicationId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}