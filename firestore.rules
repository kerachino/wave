rules_version = '2';

// ============================================================
// Firestore セキュリティルール（チャット・契約・決済用）
// Firebase コンソール（Firestore > Rules）に貼り付けて使用してください。
//
// ・chat_rooms/{roomId}                    … チャットルーム
// ・chat_rooms/{roomId}/messages/{id}      … メッセージ
// ・projects/{projectId}                     … 1件のご依頼（購入内容・契約条件・同意ログ・決済状況）
// ・orders/{uid}                            … 既存の依頼（移行前のデータ。読み取りのみ）

// ・purchase_consents/{id}                 … 同意ログの追記専用アーカイブ（サーバーのみ）
// ・users/{uid}                            … ユーザー情報（isAdmin など）
// ・quotes/{quoteId}                       … 見積書（書き込みは運営のみ）
// ・square_invoices/{invoiceId}            … Square 請求書の対応表（サーバーのみ）
//
// 決済の確定（paymentStatus / accessUnlocked など）と同意ログ
// （projectConsent / subscriptionConsent）は、Square からの Webhook と
// 請求書 API を検証したうえで サーバー（Firebase Admin SDK）だけが書き込みます。
// クライアントからは書き込めないため、不正な制限解除や同意の改ざんはできません。
//
// 運営側（スタッフ）の返信は Firebase コンソールから行う想定です。
// コンソールからの書き込みは、このルールの制約を受けません。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ヘルパー：リクエスト者が認証済みか
    function isSignedIn() {
      return request.auth != null;
    }

    // ヘルパー：スタッフ（管理者）かどうか。users ドキュメントが存在しない場合は false。
    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ヘルパー：リクエスト者がデータの持ち主か
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- チャットルーム ----
    match /chat_rooms/{roomId} {
      allow create: if isOwner(roomId) || isStaff();
      allow read, update, delete: if isOwner(roomId) || isStaff();
      allow list: if isSignedIn();

      // ---- メッセージ ----
      match /messages/{messageId} {
        allow read: if isOwner(roomId) || isStaff();
        allow create: if (isOwner(roomId) || isStaff())
          && request.resource.data.uid == roomId;
      }
    }

    // ---- 1件のご依頼（プロジェクト） ----
    match /projects/{projectId} {
      allow list: if isSignedIn();
      allow read: if isOwner(resource.data.uid) || isStaff();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isStaff();
    }

    // ---- 旧 orders（移行前） ----
    match /orders/{uid} {
      allow list: if isSignedIn();
      allow read: if isOwner(uid) || isStaff();
      allow write: if isStaff();
    }

    // ---- 同意ログ（追記専用のアーカイブ） ----
    match /purchase_consents/{consentId} {
      allow read, write: if false;
    }

    // ---- Square 請求書とお客さまの対応表 ----
    match /square_invoices/{invoiceId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid) && request.resource.data.isAdmin == false;
      allow update: if isOwner(uid)
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'displayName', 'photoURL']);
      allow delete: if false;
    }

    match /quotes/{quoteId} {
      allow read: if isOwner(resource.data.uid) || isStaff();
      allow create: if isStaff();
      allow update, delete: if isStaff();
    }
  }
}