rules_version = '2';

// ============================================================
// Firestore セキュリティルール（チャット・契約・決済用）
// Firebase コンソール（Firestore > Rules）に貼り付けて使用してください。
//
// ・chat_rooms/{roomId}                    … チャットルーム
// ・chat_rooms/{roomId}/messages/{id}      … メッセージ
// ・orders/{uid}                           … 購入内容・契約条件・同意ログ・決済状況（書き込みは運営のみ）
// ・purchase_consents/{id}                 … 同意ログの追記専用アーカイブ（サーバーのみ）
// ・users/{uid}                            … ユーザー情報（isAdmin など）
// ・quotes/{quoteId}                       … 見積書（書き込みは運営のみ）
// ・square_invoices/{invoiceId}            … Square 請求書の対応表（サーバーのみ）
//
// 決済の確定（paymentStatus / accessUnlocked など）と同意ログ
// （projectConsent / subscriptionConsent）は、Square からの Webhook と
// 請求書 API を検証したうえで サーバー（Firebase Admin SDK）だけが書き込みます。
// クライアントからは書き込めないため、不正な制限解除や同意の改ざんはできません。
//
// 運営側（スタッフ）の返信は Firebase コンソールから行う想定です。
// コンソールからの書き込みは、このルールの制約を受けません。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- チャットルーム ----
    // ログイン済みユーザーのみ、自分の uid のルームを作成・読み書きできます。
    match /chat_rooms/{roomId} {
      allow create: if request.auth != null
        && (request.resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow read, update, delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow list: if request.auth != null;

      // ---- メッセージ ----
      // ルームの持ち主のみ読み書きできます。
      match /messages/{messageId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.uid == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
        allow create: if request.auth != null
          && (request.resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
          && get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.uid == roomId;
      }
    }

    // ---- 購入内容・契約条件・同意ログ ----
    // お客さまは自分の内容を読むだけ。書き込みは運営（isAdmin）のみで、
    // 決済確定・同意ログはサーバー（Admin SDK）が記録します。
    match /orders/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ---- 同意ログ（追記専用のアーカイブ） ----
    // 請求書 API（サーバー）が作成します。クライアントからは読み書きできません。
    match /purchase_consents/{consentId} {
      allow read, write: if false;
    }

    // ---- Square 請求書とお客さまの対応表 ----
    // Webhook（サーバー）が作成・参照します。クライアントからは読み書きできません。
    match /square_invoices/{invoiceId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.isAdmin == false;
      allow update, delete: if false;
    }

    match /quotes/{quoteId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}